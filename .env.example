# ==========================================
# Online Sales Transcription Engine (.env)
# ==========================================

# Application Settings
APP_NAME="Online Sales Transcription Engine"
APP_VERSION="1.0.0"
ENV="development"
HOST="0.0.0.0"
PORT=8000

# Security (Header: X-Internal-API-Key)
INTERNAL_API_KEY="sales-secret-api-key-change-in-prod"

# Faster-Whisper Model Settings
# Perfiles disponibles:
#   - "base": Ultraligero (140MB). Ideal para desarrollo rapido y pruebas en CPU.
#   - "small": Equilibrado (460MB). Mayor precision general.
#   - "large-v3-turbo": MAXIMA PRECISION (809MB). Entiende jerga comercial, marcas de e-commerce, modismos y acentos.
WHISPER_MODEL_SIZE="base"

# Options for WHISPER_DEVICE: cpu, cuda
WHISPER_DEVICE="cpu"

# Options for WHISPER_COMPUTE_TYPE:
# For CPU: int8, float32
# For GPU (CUDA): float16, int8_float16, int8, float32
WHISPER_COMPUTE_TYPE="int8"

# Optional path to local cache folder for model weights (empty uses huggingface default cache)
WHISPER_DOWNLOAD_ROOT="./models_cache"

# ==========================================
# Vocabulario E-Commerce & Ventas Online
# ==========================================
# Sesgo acustico para mejorar la ortografia de marcas, metodos de pago y terminos comerciales.
WHISPER_INITIAL_PROMPT="Llamada de ventas y atencion al cliente en Honduras entre asesor y comprador. Modismos y comercio local: ocupar, lo ocupo, ocupamos, fijese que, mire que, venir a dejar a la casa, venirlo a dejar, ir a dejar, servicio a domicilio, delivery, cuanto se tardan, ahorita, ahoritita, ya merito, como es el asunto, perchero, perchero de ropa, cotizacion, precio, descuento, lempiras, pago contra entrega, transferencia bancaria, Banco Atlantida, BAC, Ficohsa, Banpais, Banco de Occidente, Tigo Money, encomienda, guia de rastreo, Tegucigalpa, San Pedro Sula, La Ceiba, Choloma, El Progreso."

# ==========================================
# Long Audio Optimization (30 - 60 min calls)
# ==========================================
# Dedicated CPU threads per transcription (prevents CPU thrashing when multiple audios arrive)
WHISPER_CPU_THREADS=4

# Background workers for reading/decoding audio files
WHISPER_NUM_WORKERS=1

# Beam search width (1=Greedy/Fastest, 2=Balanced 2x speedup, 5=Exhaustive/Slow)
WHISPER_BEAM_SIZE=2

# Enable BatchedInferencePipeline for 3x - 5x speedup on long audio files
WHISPER_USE_BATCHED=true

# Batch size for BatchedInferencePipeline (e.g. 8 for CPU, 16 for GPU)
WHISPER_BATCH_SIZE=8

# Anti-hallucination: avoids repeating errors across long sessions
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# Voice Activity Detection: discards silent pauses longer than 500ms
WHISPER_VAD_MIN_SILENCE_DURATION_MS=500

# Concurrency & Workloads
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Audio Temp Directory
TEMP_DIR="./tmp/transcriptions"

# Callback HTTP Client Settings
CALLBACK_TIMEOUT_SECONDS=30.0

# ==========================================
# Speaker Diarization Settings (Asesor vs Cliente)
# ==========================================
# Activa el motor acustico de separacion de interlocutores
ENABLE_ACOUSTIC_DIARIZATION=true

# Opcional: HuggingFace Token para PyAnnote Audio (speaker-diarization-3.1 biometrico)
# Si esta vacio, utiliza el detector acustico conversacional de turnos por pausas
HF_TOKEN=""

# Numero esperado de interlocutores en llamada de ventas (Asesor + Cliente)
DIARIZATION_MIN_SPEAKERS=2
DIARIZATION_MAX_SPEAKERS=2